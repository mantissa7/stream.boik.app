# Base URL of the stream backend API (separate repo, served from boik.app).
# Used for both the livestream lookup (/youtube/live) and the Twitch chat login
# (/twitch-auth/*). Production uses https://boik.app (see .env.production).
# Leave blank in dev to use the same-origin Vite proxy (see vite.config.ts).
VITE_STREAM_API_BASE=https://boik.app

# Dev only: where the Vite proxy forwards /twitch-auth and /youtube. Point this
# at a locally running backend to develop the OAuth flow end-to-end. Defaults to
# https://boik.app when unset.
# VITE_DEV_API_PROXY=http://localhost:8787

# NOTE: the Twitch Client ID / Secret live in the BACKEND, not here. The browser
# never needs them in the Authorization Code flow.
